{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["@antfu/skills", "taze"]
    },
    "packages/core": {
      "entry": ["src/templates/main.ts", "src/templates/preload.ts"],
      "ignore": ["test/__snapshots__/**/*"]
    },
    "examples/quick-start": {
      "vite": false,
      "entry": ["src/main.ts", "src/pages/**/*.vue", "desktop.config.ts"],
      "ignore": ["vite.config.ts"],
      "ignoreDependencies": [
        "@dcloudio/uni-cli-shared",
        "@dcloudio/uni-components",
        "@dcloudio/uni-h5",
        "@dcloudio/uni-stacktracey",
        "@dcloudio/vite-plugin-uni",
        "electron",
        "vite"
      ]
    }
  }
}
