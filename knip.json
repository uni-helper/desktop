{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/templates/main.ts",
        "src/templates/preload.ts"
      ],
      "ignore": ["test/__snapshots__/**/*"],
      "ignoreDependencies": ["@antfu/skills", "taze"]
    },
    "examples/quick-start": {
      "vite": false,
      "entry": ["src/main.ts", "src/pages/**/*.vue", "unh.config.ts"],
      "ignore": ["vite.config.ts"],
      "ignoreDependencies": [
        "@dcloudio/uni-cli-shared",
        "@dcloudio/uni-components",
        "@dcloudio/uni-h5",
        "@dcloudio/uni-stacktracey"
      ]
    }
  }
}
