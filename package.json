{
  "name": "@uni-helper/desktop",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.8.1",
  "description": "SDK-configured Electron build and packaging for uni-app desktop apps",
  "author": "FliPPeDround <flippedround@qq.com>",
  "license": "MIT",
  "funding": "https://afdian.com/a/flippedround",
  "homepage": "https://github.com/uni-helper/desktop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/desktop.git"
  },
  "bugs": "https://github.com/uni-helper/desktop/issues",
  "keywords": [
    "uni-app",
    "electron",
    "desktop",
    "packaging",
    "shim",
    "uni-helper"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./main": "./dist/runtime/index.mjs",
    "./shim": "./dist/shim/index.mjs",
    "./shim/channels": "./dist/shim/channels.mjs",
    "./shim/apis": "./dist/shim/apis.mjs",
    "./vite": {
      "types": "./dist/vite/index.d.mts",
      "import": "./dist/vite/index.mjs",
      "require": "./dist/vite/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "knip": "knip",
    "lint": "eslint --cache",
    "release": "bumpp",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run test",
    "prepare": "git config core.hooksPath .githooks && simple-git-hooks && skills experimental_sync --agent codex -y"
  },
  "scripts-info": {
    "build": "Build the package",
    "dev": "Rebuild the package on change",
    "knip": "Find unused files, exports and dependencies",
    "lint": "Check for code style issues",
    "release": "Bump version and publish a release",
    "test": "Run the test suite",
    "typecheck": "Check types",
    "ci": "Run the full continuous integration pipeline",
    "prepare": "Set up git hooks and skills"
  },
  "peerDependencies": {
    "electron": ">=20",
    "electron-builder": ">=24",
    "electron-updater": ">=6"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "electron-builder": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "catalog:build",
    "@uni-helper/jsonu": "catalog:build",
    "consola": "catalog:build",
    "esbuild": "catalog:build",
    "unconfig": "catalog:build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:cli",
    "@antfu/skills": "catalog:agentic",
    "@types/node": "catalog:types",
    "bumpp": "catalog:cli",
    "electron": "catalog:desktop",
    "electron-builder": "catalog:desktop",
    "electron-updater": "catalog:desktop",
    "eslint": "catalog:cli",
    "eslint-plugin-slop": "catalog:cli",
    "eslint-plugin-sonarjs": "catalog:cli",
    "happy-dom": "catalog:testing",
    "knip": "catalog:cli",
    "nano-staged": "catalog:cli",
    "simple-git-hooks": "catalog:cli",
    "skills": "catalog:agentic",
    "taze": "catalog:cli",
    "tsdown": "catalog:cli",
    "tsdown-stale-guard": "catalog:testing",
    "tsnapi": "catalog:testing",
    "typescript": "catalog:cli",
    "vite": "^7.0.0",
    "vitest": "catalog:testing"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm i --frozen-lockfile --ignore-scripts --offline && pnpm run ci && pnpx nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,tsx,json,css,md,yaml,vue}": "eslint --fix --no-warn-ignored"
  }
}
