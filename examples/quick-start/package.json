{
  "name": "@uni-helper/desktop-example-quick-start",
  "version": "0.0.0",
  "private": true,
  "description": "Quick start example for @uni-helper/desktop",
  "scripts": {
    "dev:h5": "uni",
    "build:h5": "uni build",
    "dev:desktop": "uni -p desktop",
    "build:desktop": "uni build -p desktop"
  },
  "uni-app": {
    "scripts": {
      "desktop": {
        "title": "桌面端",
        "env": {
          "UNI_PLATFORM": "h5"
        },
        "define": {
          "DESKTOP": true,
          "H5": false,
          "WEB": false
        }
      }
    }
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5030320261023001",
    "@dcloudio/uni-components": "3.0.0-5030320261023001",
    "@dcloudio/uni-h5": "3.0.0-5030320261023001",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5030320261023001",
    "@dcloudio/uni-stacktracey": "3.0.0-5030320261023001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5030320261023001",
    "@uni-helper/desktop": "workspace:*",
    "electron": "catalog:",
    "electron-builder": "catalog:desktop",
    "electron-updater": "catalog:desktop",
    "vite": "5.2.8"
  }
}
